# Copy to .env and replace every placeholder before starting.
PORT=3000
HOST=0.0.0.0
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=replace-this-with-a-unique-long-random-password
# Exact E.164 number assigned to you by your SMS provider.
OWNED_NUMBER=+12125550123
# Base64 Ed25519 public key from Telnyx. Never put an API secret here.
TELNYX_PUBLIC_KEY=replace-with-your-telnyx-webhook-public-key
RETENTION_HOURS=24
DATABASE_PATH=./data/messages.sqlite
